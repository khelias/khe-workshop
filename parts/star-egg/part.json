    "checks": [
      {
        "id": "closed",
        "label": {
          "et": "Kokkupandud kuubik mahub munasse ja kork läheb peale",
          "en": "The packed cube fits and the cap goes on"
        },
        "defines": {
          "mode": "closed"
        },
        "expect": "clear"
      },
      {
        "id": "raised",
        "label": {
          "et": "1,5 mm kõrgemale jäänud tükk ei lase korki peale",
          "en": "A piece standing 1.5 mm high stops the cap"
        },
        "defines": {
          "mode": "raised",
          "lift": 1.5
        },
        "expect": "contact"
      },
      {
        "id": "thread",
        "label": {
          "et": "Keermel on vahet, kork ei hõõrdu alusesse",
          "en": "The thread has play, the cap does not rub the base"
        },
        "defines": {
          "mode": "thread"
        },
        "expect": "clear"
      },
      {
        "id": "side-gap",
        "label": {
          "et": "Kuubiku ja süvendi seina vahel on vähemalt 0,3 mm",
          "en": "At least 0.3 mm between the cube and the pocket wall"
        },
        "defines": {
          "mode": "walls"
        },
        "expect": "value",
        "log_key": "side_gap",
        "min": 0.3
      },
      {
        "id": "corner-wall",
        "label": {
          "et": "Süvendi nurga ja keerme vahel on vähemalt 1,5 mm seina",
          "en": "At least 1.5 mm of wall between the pocket corner and the thread"
        },
        "defines": {
          "mode": "walls"
        },
        "expect": "value",
        "log_key": "corner_wall",
        "min": 1.5
      },
      {
        "id": "bore-wall",
        "label": {
          "et": "Korgi sein on keerme kohal vähemalt 1,5 mm paks",
          "en": "The cap wall over the thread is at least 1.5 mm thick"
        },
        "defines": {
          "mode": "walls"
        },
        "expect": "value",
        "log_key": "bore_wall",
        "min": 1.5
      },
      {
        "id": "overlap",
        "label": {
          "et": "Värvilised osad ei kattu",
          "en": "No two colour parts overlap"
        },
        "defines": {
          "mode": "overlap",
          "steps": 32
        },
        "expect": "clear",
        "max_mm3": 0.001
      },
      {
        "id": "union-minus-parts",
        "label": {
